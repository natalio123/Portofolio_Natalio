---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout title="Personal Homepage" active="skills">
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/skills.css" />
  </Fragment>

  <section class="skills">
    <h2 class="heading">My <span>Skills</span></h2>

    <div class="row">
      <div class="column">
        <h3 class="title">Programming Languages</h3>

        <div class="box">
          <div class="content">
            <div class="progress">
              <h3>Python <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>

            <div class="progress">
              <h3>SQL <span>95%</span></h3>
              <div class="bar"><span style="width: 95%;"></span></div>
            </div>

            <div class="progress">
              <h3>R <span>75%</span></h3>
              <div class="bar"><span style="width: 75%;"></span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="column">
        <h3 class="title">Data Science & Machine Learning</h3>

        <div class="box">
          <div class="content">
            <div class="progress">
              <h3>Data Analysis <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>

            <div class="progress">
              <h3>Machine Learning <span>80%</span></h3>
              <div class="bar"><span style="width: 80%;"></span></div>
            </div>

            <div class="progress">
              <h3>TensorFlow <span>75%</span></h3>
              <div class="bar"><span style="width: 75%;"></span></div>
            </div>

            <div class="progress">
              <h3>Pandas <span>85%</span></h3>
              <div class="bar"><span style="width: 85%;"></span></div>
            </div>

            <div class="progress">
              <h3>Matplotlib <span>80%</span></h3>
              <div class="bar"><span style="width: 80%;"></span></div>
            </div>

            <div class="progress">
              <h3>YOLOv8n <span>80%</span></h3>
              <div class="bar"><span style="width: 80%;"></span></div>
            </div>

            <div class="progress">
              <h3>OCR (Paddle) <span>70%</span></h3>
              <div class="bar"><span style="width: 70%;"></span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="column">
        <h3 class="title">Tools & Platforms</h3>

        <div class="box">
          <div class="content">
            <div class="progress">
              <h3>Microsoft Excel <span>95%</span></h3>
              <div class="bar"><span style="width: 95%;"></span></div>
            </div>

            <div class="progress">
              <h3>Microsoft Power BI <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>

            <div class="progress">
              <h3>n8n <span>70%</span></h3>
              <div class="bar"><span style="width: 70%;"></span></div>
            </div>

            <div class="progress">
              <h3>AWS <span>70%</span></h3>
              <div class="bar"><span style="width: 70%;"></span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="column">
        <h3 class="title">Professional & Soft Skills</h3>

        <div class="box">
          <div class="content">
            <div class="progress">
              <h3>Math & Statistics <span>80%</span></h3>
              <div class="bar"><span style="width: 80%;"></span></div>
            </div>

            <div class="progress">
              <h3>Business <span>75%</span></h3>
              <div class="bar"><span style="width: 75%;"></span></div>
            </div>

            <div class="progress">
              <h3>Communication <span>85%</span></h3>
              <div class="bar"><span style="width: 85%;"></span></div>
            </div>

            <div class="progress">
              <h3>Team Work <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>

            <div class="progress">
              <h3>Problem Solving <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>

            <div class="progress">
              <h3>Public Speaking <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>

            <div class="progress">
              <h3>Critical Thinking <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>

            <div class="progress">
              <h3>Time Management <span>85%</span></h3>
              <div class="bar"><span style="width: 85%;"></span></div>
            </div>

            <div class="progress">
              <h3>Leadership <span>90%</span></h3>
              <div class="bar"><span style="width: 90%;"></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>