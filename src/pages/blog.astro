---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/blog.js';
export const prerender = true;
---

<Layout title="Personal Homepage" active="blog">
  <Fragment slot="head">
    {/* index_blog.css sudah memuat semua style + media query responsive-nya,
        jadi tidak perlu lagi <style> inline duplikat seperti pada index_blog.php asli */}
    <link rel="stylesheet" href="/styles/index_blog.css" />
  </Fragment>

  <section class="blog">
    <h2 class="heading">Kumpulan <span>Blog</span></h2>

    {posts.length > 0 ? (
      posts.map((post) => (
        <article>
          <div class="articleimg">
            <img src={post.gambar} alt={post.judul} />
          </div>
          <div class="articletxt">
            <h2>{post.judul}</h2>
            <p>{post.konten1}</p>
            <a href={`/blog/${post.id}`}>Read More...</a><br />
          </div>
        </article>
      ))
    ) : (
      <p>Tidak ada artikel</p>
    )}
  </section>

  <script src="/blog.js" is:inline></script>
</Layout>
